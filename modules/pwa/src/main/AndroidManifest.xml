<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="AXOLOTL PWA Studio" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".PwaStudioActivity" android:exported="true" android:label="PWA Studio">
            <intent-filter>
                <action android:name="app.axolotl.action.MODULE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="app.axolotl.module.ID" android:value="pwa-studio" />
            <meta-data android:name="app.axolotl.module.TITLE" android:value="PWA Studio" />
            <meta-data android:name="app.axolotl.module.DESCRIPTION" android:value="Create and run isolated local web modules" />
            <meta-data android:name="app.axolotl.module.VERSION" android:value="1" />
            <meta-data android:name="app.axolotl.module.ICON" android:value="BROWSER" />
            <meta-data android:name="app.axolotl.module.CAPABILITIES" android:value="WEB_CONTENT" />
        </activity>
    </application>
</manifest>
