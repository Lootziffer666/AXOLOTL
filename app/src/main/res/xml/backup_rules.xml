<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Keystore keys are device-bound; never back up the encrypted DB without its key. -->
    <exclude domain="database" path="dock_database" />
    <exclude domain="database" path="dock_database-wal" />
    <exclude domain="database" path="dock_database-shm" />
    <exclude domain="database" path="dock_database.encrypted-new" />
    <exclude domain="database" path="dock_database.plaintext-backup" />
    <exclude domain="sharedpref" path="database_key_material.xml" />
</full-backup-content>
