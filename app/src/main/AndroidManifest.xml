<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="app.axolotl.action.MODULE" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <service
            android:name=".DockOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <activity
            android:name=".ShortcutActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="borderline" />
            </intent-filter>
            <intent-filter>
                <action android:name="app.axolotl.borderline.ACTION_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BorderlineShortcutReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.axolotl.borderline.OPEN_MENU" />
                <action android:name="app.axolotl.borderline.ADD_SNIPPET" />
                <action android:name="app.axolotl.borderline.APPEND_APPENDIX" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".BorderlineActivity"
            android:exported="false"
            android:label="Borderline"
            android:theme="@style/Theme.MyApplication" />

        <activity android:name=".FilesActivity" android:exported="true" android:label="Files">
            <intent-filter><action android:name="app.axolotl.action.MODULE" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <meta-data android:name="app.axolotl.module.ID" android:value="files" />
            <meta-data android:name="app.axolotl.module.TITLE" android:value="Files" />
            <meta-data android:name="app.axolotl.module.DESCRIPTION" android:value="Browse real document-provider folders" />
            <meta-data android:name="app.axolotl.module.VERSION" android:value="1" />
            <meta-data android:name="app.axolotl.module.ICON" android:value="FILES" />
            <meta-data android:name="app.axolotl.module.CAPABILITIES" android:value="FILE_INDEX" />
        </activity>
        <activity android:name=".BrowserActivity" android:exported="true" android:label="Browser">
            <intent-filter><action android:name="app.axolotl.action.MODULE" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <meta-data android:name="app.axolotl.module.ID" android:value="browser" />
            <meta-data android:name="app.axolotl.module.TITLE" android:value="Browser" />
            <meta-data android:name="app.axolotl.module.DESCRIPTION" android:value="Hardened HTTP/HTTPS WebView" />
            <meta-data android:name="app.axolotl.module.VERSION" android:value="1" />
            <meta-data android:name="app.axolotl.module.ICON" android:value="BROWSER" />
            <meta-data android:name="app.axolotl.module.CAPABILITIES" android:value="WEB_CONTENT" />
        </activity>
        <activity android:name=".AiModelsActivity" android:exported="true" android:label="AI &amp; Models">
            <intent-filter><action android:name="app.axolotl.action.MODULE" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <meta-data android:name="app.axolotl.module.ID" android:value="ai-models" />
            <meta-data android:name="app.axolotl.module.TITLE" android:value="AI &amp; Models" />
            <meta-data android:name="app.axolotl.module.DESCRIPTION" android:value="OpenAI-compatible HTTPS gateway" />
            <meta-data android:name="app.axolotl.module.VERSION" android:value="1" />
            <meta-data android:name="app.axolotl.module.ICON" android:value="AI" />
            <meta-data android:name="app.axolotl.module.CAPABILITIES" android:value="AI_GATEWAY" />
        </activity>
        <activity android:name=".AutomateActivity" android:exported="true" android:label="Automate">
            <intent-filter><action android:name="app.axolotl.action.MODULE" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <meta-data android:name="app.axolotl.module.ID" android:value="automate" />
            <meta-data android:name="app.axolotl.module.TITLE" android:value="Automate" />
            <meta-data android:name="app.axolotl.module.DESCRIPTION" android:value="Review and roll back declarative patches" />
            <meta-data android:name="app.axolotl.module.VERSION" android:value="1" />
            <meta-data android:name="app.axolotl.module.ICON" android:value="AUTOMATE" />
            <meta-data android:name="app.axolotl.module.CAPABILITIES" android:value="GENERATIVE_UI" />
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
